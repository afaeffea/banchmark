# ШАБЛОН. Скопируйте в .env и заполните значениями.
# Реальные ключи держите только в .env — этот файл не в .gitignore и уедет в репозиторий.

# ---------- STT/TTS: Yandex SpeechKit ----------
# Сервисный API-ключ (Api-Key) или IAM-токен. Проще всего — статический API-ключ сервисного аккаунта.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# ---------- Tool-calling ----------
# Имена переменных здесь должны совпадать с полем api_key_env в toolcalling_bench/models.yaml.
# По умолчанию все модели ходят через роутер, поэтому нужен только один ключ:
TOKENROUTER_API_KEY=
# Прямые ключи вендоров — нужны, только если сменить base_url модели на её родной API:
QWEN_API_KEY=
GLM_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
MINIMAX_API_KEY=

# ---------- Датасет (STT/TTS) ----------
# Обычно не требуется для google/fleurs (открытый датасет), но можно указать HF-токен, если понадобится.
HF_TOKEN=
